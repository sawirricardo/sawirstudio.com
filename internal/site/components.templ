package site

import "strconv"

// card is a project's card: in the project list (with its filter data, an h2 and the
// picture's page-transition name) or in a "More projects" row.
templ card(p Project, inList bool) {
	if inList {
		<a class="card" href={ templ.SafeURL("/projects/" + p.Slug + "/") } data-categories={ p.categories() } data-search={ p.Search }>
			@cardBody(p, inList)
		</a>
	} else {
		<a class="card" href={ templ.SafeURL("/projects/" + p.Slug + "/") }>
			@cardBody(p, inList)
		</a>
	}
}

templ cardBody(p Project, inList bool) {
	if p.App {
		<div class="thumb thumb-app">
			@cardImage(p, inList, "")
		</div>
	} else {
		@cardImage(p, inList, "thumb")
	}
	<div class="card-body">
		if inList {
			<h2>{ p.Title }</h2>
		} else {
			<h3>{ p.Title }</h3>
		}
	</div>
}

templ cardImage(p Project, inList bool, class string) {
	<img { imgAttrs(p, inList, class)... } src={ p.Image } alt={ p.alt() } loading="lazy"/>
}

func imgAttrs(p Project, inList bool, class string) templ.OrderedAttributes {
	var a templ.OrderedAttributes
	if inList {
		// The picture grows into the one at the top of the project's page.
		a = append(a, templ.KeyValue[string, any]{Key: "style", Value: "view-transition-name: media-" + p.Slug})
	}
	if p.Width > 0 {
		a = append(a,
			templ.KeyValue[string, any]{Key: "width", Value: strconv.Itoa(p.Width)},
			templ.KeyValue[string, any]{Key: "height", Value: strconv.Itoa(p.Height)})
	}
	if class != "" {
		a = append(a, templ.KeyValue[string, any]{Key: "class", Value: class})
	}
	return a
}

templ projectCards(ps []Project) {
	// One card per line: scripts/markdown_pages.py needs the space between them.
	for _, p := range ps {
		@card(p, true)
		{ "\n" }
	}
}

// clientRow lists the other projects for the same client.
templ clientRow(client, url string, ps []Project) {
	<section class="section related">
		<h2 class="section-title">More for <a href={ templ.SafeURL(url) }>{ client }</a></h2>
		<div class="project-grid">
			for _, p := range ps {
				{ "\n" }
				@card(p, false)
			}
			{ "\n" }
		</div>
	</section>
}

// clientPage is a client's own page: who they are, their quote, and the projects we did for them.
templ clientPage(c Client, ps []Project) {
	<section class="section banner narrow" role="banner">
		<nav class="breadcrumbs" aria-label="Breadcrumb">
			<ol>
				<li><a href="/">Home</a></li>
				<li><a href="/clients/">Clients</a></li>
				<li><a href={ templ.SafeURL("/clients/" + c.Slug + "/") } aria-current="page">{ c.Name }</a></li>
			</ol>
		</nav>
		<h1 class="page-title heavy">{ c.Name }</h1>
		<p class="lead-sm">@templ.Raw(c.Intro)</p>
	</section>
	if c.Quote != "" {
		<section class="section">
			<div class="prose">
				<figure class="pull-quote">
					<blockquote><p>@templ.Raw(c.Quote)</p></blockquote>
					<figcaption>{ c.Name }</figcaption>
				</figure>
			</div>
		</section>
	}
	<section class="section related">
		<h2 class="section-title">What we built</h2>
		<div class="project-grid">
			for _, p := range ps {
				{ "\n" }
				@card(p, false)
			}
			{ "\n" }
		</div>
	</section>
}

// clientList is the clients page: every client, with what we built for each.
templ clientList(cs []Client, ps []Project) {
	<section class="section banner narrow" role="banner">
		<nav class="breadcrumbs" aria-label="Breadcrumb">
			<ol>
				<li><a href="/">Home</a></li>
				<li><a href="/clients/" aria-current="page">Clients</a></li>
			</ol>
		</nav>
		<h1 class="page-title heavy">Clients</h1>
		<p class="lead-sm">The companies and institutions we&rsquo;ve built for, and what we built for each of them.</p>
	</section>
	for _, c := range cs {
		<section class="section related client-group" id={ c.Slug }>
			<h2 class="section-title">
				if c.hasPage(ps) {
					<a href={ templ.SafeURL("/clients/" + c.Slug + "/") }>{ c.Name }</a>
				} else {
					{ c.Name }
				}
			</h2>
			<p class="lead-sm">@templ.Raw(c.Intro)</p>
			<div class="project-grid">
				for _, p := range clientProjects(ps, c.Name) {
					{ "\n" }
					@card(p, false)
				}
				{ "\n" }
			</div>
		</section>
	}
}

// clientLogos is the homepage's rolling strip of client logos. The list is there twice so the
// loop is seamless; the copy is hidden from screen readers and the keyboard.
templ clientLogos(cs []Client, ps []Project) {
	<section class="logo-strip" aria-label="Some of our clients">
		<p class="logo-strip-label">Trusted by</p>
		<div class="logo-marquee">
			@logoTrack(cs, ps, false)
			@logoTrack(cs, ps, true)
		</div>
	</section>
}

templ logoTrack(cs []Client, ps []Project, copy bool) {
	<ul class="logo-track" aria-hidden?={ copy }>
		for _, c := range cs {
			if c.Logo != "" {
				<li>
					<a class="logo-tile" href={ templ.SafeURL(clientURL(cs, ps, c.Name)) } title={ c.Name } { tabindex(copy)... }>
						<img class={ templ.KV("logo-dark", c.LogoDark) } src={ c.Logo } alt={ alt(c.Name, copy) } loading="lazy"/>
						if c.LogoLabel {
							<span>{ c.Name }</span>
						}
					</a>
				</li>
			}
			for _, b := range c.Brands {
				<li>
					<a class="logo-tile" href={ templ.SafeURL(clientURL(cs, ps, c.Name)) } title={ b.Name } { tabindex(copy)... }>
						<img src={ b.Logo } alt={ alt(b.Name, copy) } loading="lazy"/>
					</a>
				</li>
			}
		}
	</ul>
}

templ relatedRow(ps []Project) {
	<section class="section related">
		<h2 class="section-title">More projects</h2>
		<div class="project-grid">
			for _, p := range ps {
				{ "\n" }
				@card(p, false)
			}
			{ "\n" }
		</div>
	</section>
}

templ cta() {
	<section class="section" id="cta">
		<div class="cta-box shadow-xl">
			<p>Enough about us.</p>
			<h2>How can we<br/>help you?</h2>
			<a class="button" href="/contact/">Start a project</a>
		</div>
	</section>
}
