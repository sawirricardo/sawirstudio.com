package site

// newsletterForm is the signup at the end of each blog post (the <!-- @newsletter-form -->
// placeholder). It posts to our own server (cmd/server, POST /api/subscribe), which emails a
// link to confirm the address. main.js sends it with fetch and shows the thanks in place;
// without JavaScript the server answers with a page. Its text is in the page, so the
// translations cover it.
templ newsletterForm() {
	<section class="section narrow center">
		<div class="newsletter">
			<form id="newsletter-form" class="newsletter-form" action="/api/subscribe" method="post">
				<h2>Learn something from this post?</h2>
				<p>Leave your email and we&apos;ll send you new posts when they&apos;re published.</p>
				<div class="newsletter-fields">
					<input id="newsletter-email" name="email" type="email" autocomplete="email" required placeholder="Email address" aria-label="Email address"/>
					<button class="button" type="submit" data-sending="Subscribing…">Subscribe</button>
				</div>
				<!-- Left empty by people; the server drops signups that fill it in (bots). -->
				<div hidden aria-hidden="true">
					<label for="newsletter-website">Website</label>
					<input id="newsletter-website" name="website" type="text" tabindex="-1" autocomplete="off"/>
				</div>
				<p class="newsletter-note">One email per new post, nothing else. Unsubscribe any time.</p>
				<p id="newsletter-error" class="form-error" role="alert" hidden>Something went wrong. Please try again in a moment.</p>
			</form>
			<div id="newsletter-success" class="newsletter-success" role="status" tabindex="-1" hidden>
				<h2>Almost done</h2>
				<p>We&apos;ve sent you an email. Click the link in it to confirm your subscription.</p>
			</div>
		</div>
	</section>
}
