package site

import "strconv"

// Options are the site-wide settings in content/site.yaml.
type Options struct {
	// InquiryAPI is where the contact form posts. Empty means the Google Form.
	InquiryAPI string `yaml:"inquiry_api"`
}

// pageData is everything the layout needs beyond the Page itself.
type pageData struct {
	Page              *Page
	OGImageW, OGImageH int
	Projects          []Project
	Opts              Options
}

templ Layout(d pageData) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			@head(d)
		</head>
		<body>
			<a class="skip-link" href="#main">Skip to content</a>
			@header(d.Page.Path)
			<main id="main">
				@templ.Raw(expand(d))
				if d.Page.Related {
					@relatedRow(related(d.Projects, slugOf(d.Page.Path)))
				}
				if d.Page.showCTA() {
					@cta()
				}
			</main>
			@footer(d.Page)
		</body>
	</html>
}

templ head(d pageData) {
	{{ p := d.Page }}
	<meta charset="utf-8"/>
	<meta name="viewport" content="width=device-width, initial-scale=1"/>
	<meta name="theme-color" content="#fffcf5" media="(prefers-color-scheme: light)"/>
	<meta name="theme-color" content="#1a1916" media="(prefers-color-scheme: dark)"/>
	<meta name="color-scheme" content="light dark"/>
	<script>
      // Set the theme before first paint to avoid a flash of the wrong colors.
      (function () {
        var theme;
        try {
          theme = localStorage.getItem("theme");
        } catch (e) {}
        if (theme !== "light" && theme !== "dark") {
          theme = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        }
        document.documentElement.dataset.theme = theme;
      })();
    </script>
	<title>{ p.Title }</title>
	<meta name="description" content={ p.Description }/>
	<meta property="og:title" content={ p.ogTitle() }/>
	<meta property="og:description" content={ p.ogDescription() }/>
	if p.IsPage() {
		<meta property="og:url" content={ SiteURL + p.Path }/>
		<link rel="canonical" href={ SiteURL + p.Path }/>
	}
	if p.Robots != "" {
		<meta name="robots" content={ p.Robots }/>
	}
	<meta property="og:type" content={ p.OGType }/>
	<meta property="og:site_name" content="Sawir Studio"/>
	<meta property="og:image" content={ SiteURL + p.ogImagePath() }/>
	<meta property="og:image:width" content={ strconv.Itoa(d.OGImageW) }/>
	<meta property="og:image:height" content={ strconv.Itoa(d.OGImageH) }/>
	<meta property="og:image:alt" content={ p.ogTitle() }/>
	<meta name="twitter:image:alt" content={ p.ogTitle() }/>
	<meta name="twitter:card" content={ p.twitterCard() }/>
	<link rel="icon" href="/favicon.ico" sizes="48x48"/>
	<link rel="icon" href="/favicon.svg" type="image/svg+xml"/>
	<link rel="apple-touch-icon" href="/apple-touch-icon.png"/>
	<link rel="preconnect" href="https://fonts.googleapis.com"/>
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
	<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=Caveat:wght@600..700&display=swap"/>
	<link rel="stylesheet" href="/assets/css/style.css"/>
	if p.ConvertKit {
		<link rel="stylesheet" href="/assets/css/convertkit.css"/>
		<script async src="https://f.convertkit.com/ckjs/ck.5.js"></script>
	}
	<script defer src="/assets/js/main.js"></script>
	if p.LD != "" {
		@templ.Raw("<script type=\"application/ld+json\">\n" + p.LD + "</script>")
	}
	<script type="text/javascript">
      (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", "z4kdns2tll");
    </script>
	if p.IsPage() {
		@alternates(p.Path)
	}
}

// alternates are the hreflang links. scripts/i18n.py finds them by the i18n comments and
// rewrites them in the translated pages.
templ alternates(path string) {
	<!-- i18n:alternates -->
	<link rel="alternate" hreflang="en" href={ SiteURL + path }/>
	for _, l := range Langs {
		<link rel="alternate" hreflang={ l.Code } href={ SiteURL + "/" + l.Prefix + path }/>
	}
	<link rel="alternate" hreflang="x-default" href={ SiteURL + path }/>
	<!-- /i18n:alternates -->
}

var navItems = []struct{ Href, Label string }{
	{"/", "Home"},
	{"/posts/", "Blog"},
	{"/projects/", "Projects"},
	{"/about-us/", "About us"},
	{"/contact/", "Contact Us"},
}

// navCurrent is the header link's aria-current: "page" on the page itself, "true" inside its
// section (the blog and the projects).
func navCurrent(path, href string) string {
	switch {
	case path == href:
		return "page"
	case (href == "/posts/" || href == "/projects/") && len(path) > len(href) && path[:len(href)] == href:
		return "true"
	}
	return ""
}

templ header(path string) {
	<header class="site-header">
		<a class="logo" href="/" title="Home">Sawir<span>Studio</span></a>
		<nav class="site-nav">
			<ul>
				for _, n := range navItems {
					if c := navCurrent(path, n.Href); c != "" {
						<li><a href={ templ.SafeURL(n.Href) } aria-current={ c }>{ n.Label }</a></li>
					} else {
						<li><a href={ templ.SafeURL(n.Href) }>{ n.Label }</a></li>
					}
				}
			</ul>
		</nav>
		<button class="theme-toggle" type="button" aria-label="Toggle dark mode" title="Toggle dark mode">
			<svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
			<svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path></svg>
		</button>
		<hr/>
	</header>
}

templ footer(p *Page) {
	<footer class="site-footer">
		<nav class="footer-links">
			<a href="/about-us/">About</a>
			<a href="/projects/">Projects</a>
			<a href="/contact/">Contact Us</a>
			<a href="/press/">Press</a>
			<a href="/privacy/">Privacy</a>
			<a href="/terms/">Terms</a>
		</nav>
		<hr/>
		<ul class="social-links">
			<li><a href="https://github.com/sawirstudio" target="_blank" rel="nofollow noreferrer noopener">GitHub</a></li>
			<li><a href="https://www.linkedin.com/company/sawirstudio/" target="_blank" rel="noreferrer noopener">LinkedIn</a></li>
			<li><a href="https://www.instagram.com/sawirstudioid/" target="_blank" rel="noreferrer noopener">Instagram</a></li>
		</ul>
		@languages(p)
	</footer>
}

// languages is the footer's language list (rewritten by scripts/i18n.py in translations).
// 404.html links each language's home page.
templ languages(p *Page) {
	{{ path := p.Path }}
	if !p.IsPage() {
		{{ path = "/" }}
	}
	<!-- i18n:languages -->
	<ul class="lang-links" aria-label="Language">
		<li><a href={ templ.SafeURL(path) } hreflang="en" lang="en" aria-current="true">English</a></li>
		for _, l := range Langs {
			<li><a href={ templ.SafeURL("/" + l.Prefix + path) } hreflang={ l.Code } lang={ l.Code }>{ l.Name }</a></li>
		}
	</ul>
	<!-- /i18n:languages -->
}
